<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Por qué: Ocultar botones después de reversión con cobros -->
  <!-- Patrón: Heredar vista y usar attrs invisible basado en campo booleano -->
  <record id="view_account_move_form_hide_buttons" model="ir.ui.view">
    <field name="name">account.move.form.hide.buttons</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">

      <!-- Por qué: Agregar el campo a la vista para poder usarlo en invisible -->
      <!-- Patrón: Campo invisible técnico - presente pero no visible -->
      <xpath expr="//field[@name='name']" position="after">
        <field name="reversed_with_payments" invisible="1"/>
      </xpath>

      <!-- Ocultar botón "Revertir" (Reverse Entry) -->
      <!-- Por qué: Evitar que reviertan nuevamente después de ejecutar el proceso -->
      <xpath expr="//button[@name='action_reverse']" position="attributes">
        <attribute name="invisible">reversed_with_payments</attribute>
      </xpath>

      <!-- Ocultar botón "Reiniciar a borrador" (Reset to draft) -->
      <!-- Por qué: Una vez procesado, no debe volver a borrador -->
      <!-- Patrón: Buscar por special="cancel" que es el atributo del botón -->
      <xpath expr="//button[@special='cancel']" position="attributes">
        <attribute name="invisible">reversed_with_payments</attribute>
      </xpath>

      <!-- Ocultar botón draft alternativo si existe -->
      <xpath expr="//button[@name='button_draft']" position="attributes" optional="true">
        <attribute name="invisible">reversed_with_payments</attribute>
      </xpath>

    </field>
  </record>
</odoo>
