<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_move_reversal_inherit_reverse_refund" model="ir.ui.view">
    <field name="name">account.move.reversal.form.inherit.reverse.refund</field>
    <field name="model">account.move.reversal</field>
    <field name="inherit_id" ref="account.view_account_move_reversal"/>
    <field name="arch" type="xml">

      <!-- Por qué: Restringir "Revertir" estándar solo a usuarios con permiso de registrar contablemente -->
      <xpath expr="//footer/button[@name='refund_moves']" position="attributes">
        <attribute name="groups">account.group_account_manager</attribute>
      </xpath>

      <!-- Por qué: Restringir "Revertir y crear factura rectificativa" al mismo grupo -->
      <xpath expr="//footer/button[@name='modify_moves']" position="attributes">
        <attribute name="groups">account.group_account_manager</attribute>
      </xpath>

      <!-- Por qué: Agregar nuestro botón como único primario del wizard -->
      <xpath expr="//footer/button[@name='refund_moves']" position="after">
        <button name="action_reverse_and_refund_payments"
                type="object"
                class="btn-primary"
                string="Revertir con devoluciones" />
      </xpath>

    </field>
  </record>
</odoo>
